# Hoplon environment. Copy to .env and fill in. The launcher reads .env as data, never as shell.
#
# REQUIRED: Venice AI API key (https://venice.ai -> API keys).
VENICE_API_KEY=

# ---------------------------------------------------------------------------
# Optional: API keys for the offensive MCP servers. Only needed when you
# enable those servers in config/opencode.jsonc.
# ---------------------------------------------------------------------------
SHODAN_API_KEY=
NVD_API_KEY=
VIRUSTOTAL_KEY=
GREYNOISE_API_KEY=

# Active Directory / exploitation MCP credentials
NEO4J_PASSWORD=
MSF_PASSWORD=

# ---------------------------------------------------------------------------
# Optional host passthroughs. An isolated HOME has no host credentials by
# design. Enable these only when a session needs them.
# ---------------------------------------------------------------------------
# HOPLON_SHARE_SSH=1        # symlink the host ~/.ssh into the isolated home
# HOPLON_SHARE_GH=1         # symlink the host ~/.config/gh into the isolated home
# HOPLON_HOST_HOME=         # override the real account home captured at launch

# ---------------------------------------------------------------------------
# Isolation backend. HOPLON_ISOLATION selects where the stack runs:
#   host   (default) run directly on this machine, as above
#   vm     run inside a QEMU guest (scripts/vm.sh), on Linux, macOS, or Windows
#
# The guest is self-contained: its own kernel, filesystem, and user. It mounts
# only the project you point it at and persists state inside the guest, so
# nothing it does touches the host OS.
# ---------------------------------------------------------------------------
# HOPLON_ISOLATION=host

# ---------------------------------------------------------------------------
# QEMU guest knobs (used when HOPLON_ISOLATION=vm, or via scripts/vm.sh).
# ---------------------------------------------------------------------------
# HOPLON_VM_TOOLS=core             # none, core, or full toolchain in the guest
# HOPLON_VM_RAM=4096               # guest memory in MiB
# HOPLON_VM_CPUS=4                 # guest vCPUs
# HOPLON_VM_ACCEL=                 # kvm | hvf | whpx | tcg; empty = auto by host
# HOPLON_VM_DISK=20G               # guest disk size
# HOPLON_VM_SSH_KEY=~/.ssh/id_ed25519.pub  # public key authorized in the guest
# HOPLON_VM_SSH_PORT=2222          # host port forwarded to the guest sshd
# HOPLON_VM_SSH_TIMEOUT=300        # seconds to wait for sshd
# HOPLON_VM_SHARE=/path/to/dir     # optional directory shared into the guest
# HOPLON_VM_SHARE_ALLOW=1          # required to share a directory inside HOPLON_HOME

# ---------------------------------------------------------------------------
# Installer. HOPLON_OPENCODE_SHA256 pins the opencode archive's sha256 digest;
# scripts/install.sh verifies it and fails closed on a mismatch. A default hash
# for the pinned 1.18.25 linux-x64 asset is built into install.sh, so the check
# runs on that version and platform with no configuration. If you set a
# non-default HOPLON_OPENCODE_VERSION, or install a different platform's asset,
# set the matching digest here explicitly; otherwise verification fails closed.
# ---------------------------------------------------------------------------
# HOPLON_OPENCODE_SHA256=

# ---------------------------------------------------------------------------
# OMO conflict handling. If a host ~/.omo/omo.jsonc sits above the working
# directory it would override Hoplon's Venice routing. Hoplon takes that file
# over for the session and restores it on exit. Set to 0 to disable.
# ---------------------------------------------------------------------------
# HOPLON_OMO_TAKEOVER=0

# ---------------------------------------------------------------------------
# OMO plugin toggle. HOPLON_ENABLE_OMO=1 (default) keeps the Oh My OpenAgent
# harness. Set to 0 to disable it: the launcher strips the oh-my-openagent line
# from the copy of config/opencode.jsonc it seeds into the isolated XDG config
# dir, so the session runs OpenCode alone (Magic Context still loads). The repo
# copy always keeps the pinned entry, so this is per-session only.
# ---------------------------------------------------------------------------
# HOPLON_ENABLE_OMO=1

# ---------------------------------------------------------------------------
# Venice MCP server (see config/opencode.jsonc). It uses VENICE_API_KEY above.
# Only set VENICE_MCP_AUTH_TOKEN if you run the server in HTTP mode behind a
# proxy; the default stdio mode does not need it.
# ---------------------------------------------------------------------------
# VENICE_MCP_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Magic Context (see docs/magic-context.md). The context engine needs no API
# key. Its SQLite store and embedding cache live under the isolated home at
# home/.local/share/cortexkit/magic-context. Set MAGIC_CONTEXT_STORAGE_DIR to an
# absolute directory to persist that store elsewhere (for example on a mounted
# volume); every process sharing the store must use the same value.
# ---------------------------------------------------------------------------
# MAGIC_CONTEXT_STORAGE_DIR=
