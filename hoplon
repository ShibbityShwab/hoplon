#!/usr/bin/env bash
# =============================================================================
# Hoplon launcher.
#
# Portable, isolated OpenCode (with the Oh My OpenAgent harness) on Venice AI.
#
# Design: this repository is the source of truth. Everything the runtime writes
# lives under ./home (gitignored). On every launch we seed config into an
# isolated HOME and hand off to the bundled opencode binary with a fixed,
# leak-free environment, so Hoplon never reads or writes the host's OpenCode or
# OMO state.
#
# One wrinkle: OMO discovers its config by walking `.omo/omo.jsonc` from the
# working directory upward, plus a user layer at $HOME/.omo. Because HOME is
# isolated, a host ~/.omo above the working directory is seen as a *project*
# layer and would override Hoplon's Venice routing. When that conflict exists,
# Hoplon takes the host file over for the duration of the session and restores
# it on exit. On a clean machine none of this runs and nothing on the host is
# touched. Set HOPLON_OMO_TAKEOVER=0 to disable the takeover (host config wins).
#
# Set HOPLON_ENABLE_OMO=0 to run plain OpenCode: the oh-my-openagent plugin line
# is stripped from the seeded config, no $HOME/.omo/omo.jsonc is seeded, and the
# host OMO takeover is skipped. Magic Context is unaffected.
#
# Usage (after scripts/install.sh links the `hoplon` command onto PATH):
#   hoplon                   start the TUI in the current directory
#   hoplon <project>         start the TUI on a project directory
#   hoplon run "..."         one-shot prompt
#   hoplon doctor            report what this environment can do, then exit
#   hoplon version           print the Hoplon and opencode versions, then exit
#   hoplon update            update Hoplon in place (scripts/update.sh)
#   hoplon --help            opencode CLI help
#
# HOPLON_ISOLATION selects where the stack runs:
#   host        (default) run on this machine, as described above
#   vm          run inside a QEMU/KVM guest (scripts/vm.sh)
#   nix         boot the declarative NixOS guest (scripts/nix-vm.sh, flake.nix)
# =============================================================================
set -euo pipefail

# Resolve the repo root regardless of how the script was invoked, following
# symlinks first so the `hoplon` command linked onto PATH still finds its repo.
# `readlink -f` is a GNU extension that older BSD/macOS lack, so fall back to a
# manual link walk with plain `readlink`.
_hoplon_self="${BASH_SOURCE[0]}"
if command -v readlink > /dev/null 2>&1 &&
  _hoplon_real="$(readlink -f -- "$_hoplon_self" 2> /dev/null)" &&
  [ -n "$_hoplon_real" ]; then
  _hoplon_self="$_hoplon_real"
else
  while [ -h "$_hoplon_self" ]; do
    _hoplon_dir="$(cd -P "$(dirname "$_hoplon_self")" > /dev/null 2>&1 && pwd)"
    _hoplon_link="$(readlink "$_hoplon_self")"
    case "$_hoplon_link" in
      /*) _hoplon_self="$_hoplon_link" ;;
      *) _hoplon_self="$_hoplon_dir/$_hoplon_link" ;;
    esac
  done
fi
HOPLON_HOME="$(cd "$(dirname "$_hoplon_self")" > /dev/null 2>&1 && pwd -P)"
unset _hoplon_self _hoplon_real _hoplon_dir _hoplon_link 2> /dev/null || true
export HOPLON_HOME

# Capture the real account home before we isolate HOME (for opt-in passthrough).
HOPLON_HOST_HOME="${HOPLON_HOST_HOME:-${HOME:-}}"
export HOPLON_HOST_HOME

# ---------------------------------------------------------------------------
# Local environment: VENICE_API_KEY, MCP keys, passthrough flags.
#
# Read .env as data, never as code. Defense in depth: the sandbox now mounts
# this repo read-only, but any process that can write the checkout (an agent
# run unsandboxed, or a misconfigured bind) could otherwise append a command
# substitution and get host code execution on the next launch. Only NAME=value
# lines at column 0 are honored; surrounding single or double quotes are
# stripped; the value is exported verbatim. Command substitution, backticks,
# and arithmetic never run.
# ---------------------------------------------------------------------------
_hoplon_load_env() {
  [ -f "$1" ] && [ -r "$1" ] || return 0
  set -a
  while IFS= read -r _hl_line || [ -n "$_hl_line" ]; do
    _hl_line="${_hl_line%$'\r'}"
    [[ "$_hl_line" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || continue
    _hl_name="${_hl_line%%=*}"
    _hl_value="${_hl_line#*=}"
    case "$_hl_value" in
      \'*\') _hl_value="${_hl_value#\'}" && _hl_value="${_hl_value%\'}" ;;
      \"*\") _hl_value="${_hl_value#\"}" && _hl_value="${_hl_value%\"}" ;;
    esac
    export "$_hl_name=$_hl_value"
  done < "$1"
  set +a
  unset _hl_line _hl_name _hl_value 2> /dev/null || true
}
_hoplon_load_env "$HOPLON_HOME/.env"

# ---------------------------------------------------------------------------
# `hoplon update`: hand off to the updater with the host environment intact.
# Runs before HOME is isolated so the re-run installer links and seeds against
# the real account home rather than the isolated one.
# ---------------------------------------------------------------------------
if [ "${1:-}" = "update" ]; then
  shift
  exec "$HOPLON_HOME/scripts/update.sh" "$@"
fi

# ---------------------------------------------------------------------------
# Isolated HOME. All four XDG vars are set explicitly because xdg-basedir
# resolves them from the environment at import time: a host-exported XDG var
# would otherwise override the HOME-derived default and leak state out.
# ---------------------------------------------------------------------------
export HOME="$HOPLON_HOME/home"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"

# ---------------------------------------------------------------------------
# Drop host selectors that would override or redirect this install.
# ---------------------------------------------------------------------------
unset OPENCODE_CONFIG OPENCODE_CONFIG_DIR OPENCODE_CONFIG_CONTENT \
  OPENCODE_TUI_CONFIG OPENCODE_PERMISSION OPENCODE_DB \
  OPENCODE_MODELS_PATH OPENCODE_MODELS_URL 2> /dev/null || true

# ---------------------------------------------------------------------------
# Drop host credential, agent, and container-runtime selectors. The isolated
# HOME hides credential files, but an inherited env var would still carry the
# same access into the child: an SSH/GPG agent socket, cloud API keys, or a
# docker endpoint that bypasses the sandbox. XDG_RUNTIME_DIR and TMPDIR are
# reset into the isolated home so nothing points back at host state.
# ---------------------------------------------------------------------------
unset SSH_AUTH_SOCK SSH_AGENT_PID SSH_ASKPASS GIT_ASKPASS GPG_AGENT_INFO \
  KRB5CCNAME KRB5_CONFIG GITHUB_TOKEN GH_TOKEN \
  AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN \
  DOCKER_HOST DOCKER_TLS_VERIFY DOCKER_CERT_PATH DOCKER_CONTEXT \
  XDG_RUNTIME_DIR TMPDIR 2> /dev/null || true

# Azure and Google/GCP credentials use dynamic names, so sweep the exported set.
while IFS= read -r _hoplon_var; do
  case "$_hoplon_var" in
    AZURE_* | GOOGLE_* | GCP_*) unset "$_hoplon_var" ;;
  esac
done < <(compgen -e)
unset _hoplon_var 2> /dev/null || true

export XDG_RUNTIME_DIR="$HOME/.run"
export TMPDIR="$HOME/tmp"
mkdir -p "$XDG_RUNTIME_DIR" "$TMPDIR"

# Frozen distribution: no self-update, no OMO telemetry.
export OPENCODE_DISABLE_AUTOUPDATE=1
export OMO_DISABLE_POSTHOG=1
export OMO_SEND_ANONYMOUS_TELEMETRY=0

# Keep the Magic Context diagnostic log inside the isolated home. Its default is
# $TMPDIR/opencode/magic-context, which a host Magic Context install would share.
export MAGIC_CONTEXT_LOG_PATH="$HOME/.cache/cortexkit/magic-context.log"

# OMO harness toggle. Enabled by default; set to 0 to run pure OpenCode.
export HOPLON_ENABLE_OMO="${HOPLON_ENABLE_OMO:-1}"

# Bundled binary first on PATH.
export PATH="$HOPLON_HOME/bin:$PATH"

# ---------------------------------------------------------------------------
# Informational commands. These report and exit without seeding or launching,
# and run before the preflight so `hoplon version` always exits 0 even on a
# fresh checkout. They must not fall through to opencode.
# ---------------------------------------------------------------------------
_hoplon_have() { command -v "$1" > /dev/null 2>&1 && printf 'yes' || printf 'NO'; }

_hoplon_version_file() {
  if [ -f "$HOPLON_HOME/VERSION" ]; then
    tr -d '[:space:]' < "$HOPLON_HOME/VERSION"
  else
    printf 'unknown'
  fi
}

_hoplon_doctor() {
  printf 'hoplon doctor\n'
  printf '  repo                %s\n' "$HOPLON_HOME"
  printf '  opencode            %s\n' "$([ -x "$HOPLON_HOME/bin/opencode" ] && "$HOPLON_HOME/bin/opencode" --version 2> /dev/null || echo missing)"
  printf '  VENICE_API_KEY      %s\n' "$([ -n "${VENICE_API_KEY:-}" ] && echo set || echo MISSING)"
  printf '  bwrap (sandbox)     %s\n' "$(_hoplon_have bwrap)"
  printf '  node / npx          %s / %s\n' "$(_hoplon_have node)" "$(_hoplon_have npx)"
  printf '  uvx (python MCP)    %s\n' "$(_hoplon_have uvx)"
  printf '  docker (docker MCP) %s\n' "$(_hoplon_have docker)"
  printf '  weapons             '
  for _b in nmap nuclei sqlmap ffuf msfconsole ghidra; do printf '%s:%s ' "$_b" "$(_hoplon_have "$_b")"; done
  printf '\n'
  printf '  venice reachable    '
  if command -v curl > /dev/null 2>&1 && curl -fsS --max-time 6 https://api.venice.ai/api/v1/models > /dev/null 2>&1; then
    printf 'yes\n'
  else
    printf 'no (offline or curl missing)\n'
  fi
}

case "${1:-}" in
  version | --version)
    printf 'hoplon %s\n' "$(_hoplon_version_file)"
    if [ -x "$HOPLON_HOME/bin/opencode" ]; then
      printf 'opencode %s\n' "$("$HOPLON_HOME/bin/opencode" --version 2> /dev/null || printf 'unknown')"
    else
      printf 'opencode missing (run scripts/install.sh)\n'
    fi
    exit 0
    ;;
  doctor)
    _hoplon_doctor
    exit 0
    ;;
esac

# ---------------------------------------------------------------------------
# Isolation backend. `host` (default) keeps the behavior above untouched.
# `vm` hands off to the QEMU/KVM guest in scripts/vm.sh. `nix` boots the
# declarative NixOS guest from flake.nix via scripts/nix-vm.sh. Handled before
# the preflight and seed phase so a host launch takes the same path as before.
# ---------------------------------------------------------------------------
case "${HOPLON_ISOLATION:-host}" in
  host) : ;;
  vm)
    if [ ! -x "$HOPLON_HOME/scripts/vm.sh" ]; then
      printf 'hoplon: HOPLON_ISOLATION=vm but scripts/vm.sh is missing or not executable.\n' >&2
      exit 1
    fi
    exec "$HOPLON_HOME/scripts/vm.sh" "$@"
    ;;
  nix)
    if [ ! -x "$HOPLON_HOME/scripts/nix-vm.sh" ]; then
      printf 'hoplon: HOPLON_ISOLATION=nix but scripts/nix-vm.sh is missing or not executable.\n' >&2
      exit 1
    fi
    exec "$HOPLON_HOME/scripts/nix-vm.sh" "$@"
    ;;
  *)
    printf 'hoplon: invalid HOPLON_ISOLATION=%s (expected host, vm, or nix).\n' "$HOPLON_ISOLATION" >&2
    exit 1
    ;;
esac

# ---------------------------------------------------------------------------
# Preflight.
# ---------------------------------------------------------------------------
if [ ! -x "$HOPLON_HOME/bin/opencode" ]; then
  printf 'hoplon: bin/opencode not found. Run scripts/install.sh first.\n' >&2
  exit 1
fi
if [ ! -f "$HOPLON_HOME/config/opencode.jsonc" ]; then
  printf 'hoplon: config/opencode.jsonc is missing.\n' >&2
  exit 1
fi
if [ -z "${VENICE_API_KEY:-}" ]; then
  printf 'hoplon: warning: VENICE_API_KEY is not set. Copy .env.example to .env and add it.\n' >&2
fi

# ---------------------------------------------------------------------------
# Opt-in host passthroughs. An isolated HOME has no host credentials, which is
# deliberate. Turn these on per need.
# ---------------------------------------------------------------------------
mkdir -p "$HOME/.config"
if [ "${HOPLON_SHARE_SSH:-0}" = "1" ] && [ -d "$HOPLON_HOST_HOME/.ssh" ] && [ ! -e "$HOME/.ssh" ]; then
  ln -s "$HOPLON_HOST_HOME/.ssh" "$HOME/.ssh"
fi
if [ "${HOPLON_SHARE_GH:-0}" = "1" ] && [ -d "$HOPLON_HOST_HOME/.config/gh" ] && [ ! -e "$HOME/.config/gh" ]; then
  ln -s "$HOPLON_HOST_HOME/.config/gh" "$HOME/.config/gh"
fi

# ---------------------------------------------------------------------------
# Seed phase: repo -> isolated HOME. Copies only, never symlinks. OMO rewrites
# its config with a temp-file + rename replace, which severs a symlink inode;
# copying keeps this repo the single source of truth on every launch.
# ---------------------------------------------------------------------------
OC="$XDG_CONFIG_HOME/opencode"
mkdir -p "$OC/themes" "$OC/agents" "$OC/plugins" "$HOME/.omo" "$HOME/.config/cortexkit" "$HOME/.cache/cortexkit"

# Copy via a temp file and rename, so a concurrent launch never reads a
# half-written config. A missing source is tolerated: the temp copy fails, the
# rename is skipped, and the previous seeded file (if any) is left in place.
_hoplon_seed() {
  cp -f "$1" "$2.hoplon-tmp.$$" 2> /dev/null && mv -f "$2.hoplon-tmp.$$" "$2" 2> /dev/null || true
}
_hoplon_seed "$HOPLON_HOME/config/opencode.jsonc" "$OC/opencode.jsonc"
_hoplon_seed "$HOPLON_HOME/config/tui.json" "$OC/tui.json"
if [ "$HOPLON_ENABLE_OMO" != "0" ]; then
  _hoplon_seed "$HOPLON_HOME/config/omo.jsonc" "$HOME/.omo/omo.jsonc"
fi
# Magic Context reads its engine config from the cortexkit dir, not the opencode
# dir. Guard the source so a checkout without it still launches.
if [ -f "$HOPLON_HOME/config/magic-context.jsonc" ]; then
  _hoplon_seed "$HOPLON_HOME/config/magic-context.jsonc" "$HOME/.config/cortexkit/magic-context.jsonc"
fi
for _f in "$HOPLON_HOME"/themes/*.json; do [ -f "$_f" ] && _hoplon_seed "$_f" "$OC/themes/$(basename "$_f")"; done
for _f in "$HOPLON_HOME"/agents/*.md; do [ -f "$_f" ] && _hoplon_seed "$_f" "$OC/agents/$(basename "$_f")"; done
for _f in "$HOPLON_HOME"/tui/*.tsx; do [ -f "$_f" ] && _hoplon_seed "$_f" "$OC/plugins/$(basename "$_f")"; done

# With OMO disabled, remove the oh-my-openagent plugin line from the seeded
# OpenCode config and repoint default_agent at a built-in agent. The configured
# default (sisyphus) is only registered by OMO, so leaving it would make OpenCode
# fail to start. Temp file plus rename keeps the swap atomic.
if [ "$HOPLON_ENABLE_OMO" = "0" ] && [ -f "$OC/opencode.jsonc" ]; then
  _stripped="$OC/opencode.jsonc.hoplon-strip.$$"
  if sed -e '/oh-my-openagent@/d' -e 's/"default_agent": "sisyphus"/"default_agent": "build"/' \
    "$OC/opencode.jsonc" > "$_stripped" 2> /dev/null; then
    mv -f "$_stripped" "$OC/opencode.jsonc" 2> /dev/null || rm -f "$_stripped"
  else
    rm -f "$_stripped"
  fi
fi

# ---------------------------------------------------------------------------
# Git identity for agent-run commits. Snapshots need no identity; explicit
# commits do. safe.directory=* avoids dubious-ownership failures when the repo
# is copied across machines or users.
# ---------------------------------------------------------------------------
if command -v git > /dev/null 2>&1 && [ ! -f "$HOME/.gitconfig" ]; then
  git config --file "$HOME/.gitconfig" user.name "Hoplon Operator" 2> /dev/null || true
  git config --file "$HOME/.gitconfig" user.email "operator@hoplon.local" 2> /dev/null || true
  git config --file "$HOME/.gitconfig" --add safe.directory '*' 2> /dev/null || true
fi

# ---------------------------------------------------------------------------
# Login-shell shim. opencode's bash tool spawns login shells, and /etc/profile
# can rebuild PATH and drop user-local bins. Seed a profile that restores the
# bundled binary (and, optionally, host user tools).
# ---------------------------------------------------------------------------
if [ ! -f "$HOME/.profile" ]; then
  {
    printf '%s\n' '# Hoplon isolated login shell'
    printf '%s\n' '[ -n "${HOPLON_HOME:-}" ] && export PATH="$HOPLON_HOME/bin:$PATH"'
    printf '%s\n' '[ -n "${HOPLON_HOST_HOME:-}" ] && [ -d "$HOPLON_HOST_HOME/.local/bin" ] && export PATH="$HOPLON_HOST_HOME/.local/bin:$PATH"'
    printf '%s\n' '[ -n "${HOPLON_HOST_HOME:-}" ] && [ -d "$HOPLON_HOST_HOME/.bun/bin" ] && export PATH="$HOPLON_HOST_HOME/.bun/bin:$PATH"'
  } > "$HOME/.profile"
fi

# ---------------------------------------------------------------------------
# OMO project-layer conflict handling.
#
# OMO loads $HOME/.omo/omo.jsonc (user) then walks `.omo/omo.jsonc` from the
# working directory upward (project). With HOME isolated, a host ~/.omo above
# the working directory is treated as a project layer and overrides our routing.
# Detect that case and take the host file over for the session, restoring it on
# exit. Skipped entirely when there is no conflict or when disabled.
# ---------------------------------------------------------------------------
HOPLON_OMO_RESTORE=""
HOPLON_OMO_BAK=""
HOPLON_OMO_MODE=""
_hoplon_marker="HOPLON - Oh My OpenAgent"

# Original file mode lookup. GNU coreutils uses `stat -c %a`; BSD/macOS uses
# `stat -f %Lp`. `-L` dereferences a symlink so the mode captured is the target
# file's, not the link's own 0777.
_hoplon_file_mode() {
  case "$(uname -s)" in
    Darwin | *BSD*) stat -L -f '%Lp' "$1" 2> /dev/null || true ;;
    *) stat -L -c '%a' "$1" 2> /dev/null || true ;;
  esac
}

_hoplon_restore_omo() {
  if [ -n "$HOPLON_OMO_RESTORE" ] && [ -f "$HOPLON_OMO_BAK" ]; then
    if cp -f "$HOPLON_OMO_BAK" "$HOPLON_OMO_RESTORE.hoplon-restore.$$" 2> /dev/null &&
      mv -f "$HOPLON_OMO_RESTORE.hoplon-restore.$$" "$HOPLON_OMO_RESTORE" 2> /dev/null; then
      # cp creates the restored file with the backup's mode, so re-apply the
      # original file mode captured at takeover time.
      [ -n "${HOPLON_OMO_MODE:-}" ] && chmod "$HOPLON_OMO_MODE" "$HOPLON_OMO_RESTORE" 2> /dev/null || true
      # Restore succeeded; drop the backup so a later run cannot mistake it for
      # current host content.
      rm -f "$HOPLON_OMO_BAK" 2> /dev/null || true
    fi
  fi
}
trap _hoplon_restore_omo EXIT INT TERM HUP

if [ "$HOPLON_ENABLE_OMO" != "0" ] && [ "${HOPLON_OMO_TAKEOVER:-1}" != "0" ]; then
  _d="$PWD"
  _conflict=""
  while :; do
    # Stop at the isolated home or anywhere inside this repo: those .omo dirs
    # are Hoplon's own and must never be treated as a foreign host config.
    case "$_d" in "$HOME" | "$HOPLON_HOME" | "$HOPLON_HOME"/*) break ;; esac
    if [ -d "$_d/.omo" ] && [ ! -L "$_d/.omo" ]; then
      if [ -f "$_d/.omo/omo.jsonc" ]; then
        _conflict="$_d/.omo/omo.jsonc"
        break
      fi
      if [ -f "$_d/.omo/omo.json" ]; then
        _conflict="$_d/.omo/omo.json"
        break
      fi
    fi
    [ "$_d" = "/" ] && break
    _d="$(dirname "$_d")"
  done

  if [ -n "$_conflict" ]; then
    if [ -L "$_conflict" ]; then
      # Never rewrite a symlink. The temp-file plus rename below would replace
      # the link inode, severing the relationship to the real host config, and
      # a mode lookup without -L would read the link's synthetic mode. Leaving
      # it alone keeps the host file exactly as the operator set it up.
      printf 'hoplon: notice: host OMO config at %s is a symlink; skipping the takeover so the link is not clobbered.\n' "$_conflict" >&2
    else
      _bak="${_conflict}.hoplon-hostbak"
      # Self-heal: if a previous run died before restoring, put the host file back.
      if [ -f "$_bak" ] && grep -q "$_hoplon_marker" "$_conflict" 2> /dev/null; then
        cp -f "$_bak" "$_conflict" 2> /dev/null || true
      fi
      HOPLON_OMO_MODE="$(_hoplon_file_mode "$_conflict")"
      # A real host file (no Hoplon marker) is authoritative. Always refresh the
      # backup from its current content so host edits made since an earlier run
      # survive the restore. If the conflict still holds Hoplon's marker, the
      # self-heal above could not restore it, so leave the existing backup alone.
      if ! grep -q "$_hoplon_marker" "$_conflict" 2> /dev/null; then
        cp -f "$_conflict" "$_bak" 2> /dev/null || true
        chmod 600 "$_bak" 2> /dev/null || true
      fi
      # Write atomically so a killed run never leaves a half-written config.
      if cp -f "$HOPLON_HOME/config/omo.jsonc" "$_conflict.hoplon-new.$$" 2> /dev/null &&
        mv -f "$_conflict.hoplon-new.$$" "$_conflict" 2> /dev/null; then
        HOPLON_OMO_RESTORE="$_conflict"
        HOPLON_OMO_BAK="$_bak"
        printf 'hoplon: host OMO config at %s would override Venice routing; taking it over for this session (restored on exit).\n' "$_conflict" >&2
      else
        printf 'hoplon: warning: a host OMO config at %s may override Hoplon routing (could not take it over).\n' "$_conflict" >&2
      fi
    fi
  fi
fi

# ---------------------------------------------------------------------------
# Launch. Do not exec: the EXIT trap must run so a taken-over host config is
# restored when opencode exits.
#
# Optional bubblewrap sandbox (HOPLON_SANDBOX=1). The host filesystem is hidden
# except the repo (read-only), the isolated state home (read-write), and the
# target directory, while the network stays up for the Venice API. Raw-socket
# tooling (nmap -sS, ARP, packet capture) needs CAP_NET_RAW and will not work
# inside; run those unsandboxed.
# ---------------------------------------------------------------------------
if [ "${HOPLON_SANDBOX:-0}" != "0" ]; then
  if command -v bwrap > /dev/null 2>&1; then
    # /run is emptied because a host /run exposes /run/docker.sock (plus the
    # containerd, podman, and dbus sockets and /run/user keyrings): a container
    # escape straight to host root. Re-expose only the resolver runtime dirs
    # that /etc/resolv.conf may symlink into.
    _hoplon_sb=(bwrap --die-with-parent
      --unshare-user --unshare-pid --unshare-ipc --unshare-uts
      --ro-bind /usr /usr --ro-bind-try /bin /bin --ro-bind-try /lib /lib
      --ro-bind-try /lib64 /lib64 --ro-bind-try /sbin /sbin
      --ro-bind /etc /etc --ro-bind-try /opt /opt
      --proc /proc --dev /dev --tmpfs /run --tmpfs /tmp
      --ro-bind-try /run/systemd/resolve /run/systemd/resolve)
    if [ -d /run/NetworkManager ]; then
      _hoplon_sb+=(--ro-bind /run/NetworkManager /run/NetworkManager)
    fi
    # The repo is the source of truth, so mount it read-only and reopen only
    # the state home read-write. A writable repo would let a sandboxed agent
    # poison .env, config, or bin/opencode for the next unsandboxed launch.
    _hoplon_sb+=(--ro-bind "$HOPLON_HOME" "$HOPLON_HOME"
      --bind "$HOPLON_HOME/home" "$HOPLON_HOME/home")
    # Refuse to expose the whole host: launching from /, the host home, or an
    # ancestor of it would hand the agent every file under that root.
    _hoplon_pwd="$(pwd -P 2> /dev/null || printf '%s' "$PWD")"
    _hoplon_broad=""
    case "$_hoplon_pwd" in /) _hoplon_broad="/" ;; esac
    if [ -n "${HOPLON_HOST_HOME:-}" ]; then
      if [ "$_hoplon_pwd" = "$HOPLON_HOST_HOME" ]; then
        _hoplon_broad="the host home ($HOPLON_HOST_HOME)"
      elif [ -z "$_hoplon_broad" ]; then
        case "$HOPLON_HOST_HOME" in
          "$_hoplon_pwd"/*) _hoplon_broad="an ancestor of the host home ($HOPLON_HOST_HOME)" ;;
        esac
      fi
    fi
    case "$PWD" in
      "$HOPLON_HOME" | "$HOPLON_HOME"/*) : ;;
      *)
        if [ -n "$_hoplon_broad" ]; then
          if [ "${HOPLON_SANDBOX_ALLOW_BROAD:-0}" = "1" ]; then
            printf 'hoplon: WARNING: sandbox target %s is %s; exposing the whole tree read-write because HOPLON_SANDBOX_ALLOW_BROAD=1.\n' "$_hoplon_pwd" "$_hoplon_broad" >&2
          else
            printf 'hoplon: refusing to sandbox %s: it is %s. Launch from a project directory, or set HOPLON_SANDBOX_ALLOW_BROAD=1 to override.\n' "$_hoplon_pwd" "$_hoplon_broad" >&2
            exit 1
          fi
        fi
        _hoplon_sb+=(--bind "$PWD" "$PWD")
        ;;
    esac
    unset _hoplon_pwd _hoplon_broad 2> /dev/null || true
    # The host home is hidden, so tools installed per-user (pipx, cargo, go,
    # bun) would be missing. HOPLON_SANDBOX_BINS=1 exposes those bin dirs
    # read-only. Everything in /usr is already available without this.
    if [ "${HOPLON_SANDBOX_BINS:-0}" = "1" ]; then
      for _b in .local/bin .bun/bin .cargo/bin go/bin; do
        [ -d "$HOPLON_HOST_HOME/$_b" ] && _hoplon_sb+=(--ro-bind "$HOPLON_HOST_HOME/$_b" "$HOPLON_HOST_HOME/$_b")
      done
    fi
    _hoplon_sb+=(--chdir "$PWD" "$HOPLON_HOME/bin/opencode")
    printf 'hoplon: sandbox on (bwrap); host FS hidden except repo %s (read-only) and %s\n' "$HOPLON_HOME" "$PWD" >&2
    "${_hoplon_sb[@]}" "$@"
  else
    printf 'hoplon: HOPLON_SANDBOX=1 but bwrap is missing; running unsandboxed\n' >&2
    "$HOPLON_HOME/bin/opencode" "$@"
  fi
else
  "$HOPLON_HOME/bin/opencode" "$@"
fi
