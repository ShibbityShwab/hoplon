# Secrets
.env

# Bundled binary (fetched by scripts/install.sh)
/bin/opencode
/bin/*.zip
/bin/*.tar.gz

# Isolated HOME and all runtime state
/home/

# opencode may create these inside the isolated HOME or bin at runtime. Scoped
# to /home/ and /bin/ so a real manifest committed at the repo root stays
# visible.
/home/**/node_modules/
/home/**/package.json
/home/**/package-lock.json
/home/**/bun.lock
/bin/**/node_modules/
/bin/**/package.json
/bin/**/package-lock.json
/bin/**/bun.lock

# OMO project state written when an agent runs inside this repo
/.omo/

# VM state. Only vm/cloud-init/ is tracked; everything else is regenerated by
# scripts/vm.sh (the base image is a cache, the rest is per-run state).
/vm/cache/
/vm/seed/
/vm/*.qcow2
/vm/*.iso
/vm/*.pid
/vm/*.log
/vm/known_hosts
/vm/id_ed25519
/vm/id_ed25519.pub
/vm/ssh_private_key_path

# Local runtime junk
*.log
*.tmp
.DS_Store
__pycache__/

# MkDocs build output (its source is docs/ and mkdocs.yml)
/site/
