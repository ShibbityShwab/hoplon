// =============================================================================
// HOPLON - Oh My OpenAgent (OMO) runtime config.
//
// OMO reads the user layer at $HOME/.omo/omo.jsonc plus a project
// .omo/omo.jsonc walked upward from the working directory. The Hoplon launcher
// isolates $HOME into this repo and copies this file to $HOME/.omo/omo.jsonc,
// so the routing below always applies without touching the host's real config.
//
// OMO is an optional third-party add-on, not part of Hoplon: it is licensed
// SUL-1.0, developed upstream at code-yeongyu/oh-my-openagent, and is not
// redistributed here (the launcher loads the pinned npm package). Set
// HOPLON_ENABLE_OMO=0 in .env to disable it for a session; the launcher then
// strips the oh-my-openagent plugin line from the seeded OpenCode config, and
// this file has no effect for that session.
//
// Every agent and category is routed to a Venice AI *uncensored* model. Venice
// marks a subset of its catalog as uncensored, and those are the only models it
// guarantees minimal content filtering on; upstream hosts (Anthropic, OpenAI,
// Google, xAI) may still filter, so they are avoided here. Hoplon pins seven of
// the uncensored models in provider.venice.whitelist. Sampling follows Venice's
// published per-model constraints where they exist (qwen-3-6-plus: temperature
// 0.7, top_p 0.8). Reasoning effort is applied only where a model advertises an
// effort control (qwen-3-8-27b, olafangensan-glm-4.7-flash-heretic); settings
// on models without one (qwen-3-6-plus) are dropped by the harness, not sent.
//
//   qwen-3-6-plus                     uncensored flagship: code + reasoning + vision + tools, 1M ctx
//   qwen-3-8-27b                      uncensored: tunable effort (up to xhigh) + vision, 262K ctx
//   olafangensan-glm-4.7-flash-heretic uncensored: cheap, tunable effort, 200K ctx
//   venice-uncensored-1-2             most_uncensored trait: chat + vision, 128K ctx
// =============================================================================
{
  "[opencode]": {
    "agents": {
      "sisyphus": {
        "model": "venice/qwen-3-6-plus",
        "reasoning": "high",
        "temperature": 0.7,
        "top_p": 0.8,
        "maxTokens": 32768
      },
      "prometheus": {
        "model": "venice/qwen-3-6-plus",
        "reasoning": "high",
        "temperature": 0.7,
        "top_p": 0.8,
        "maxTokens": 16384
      },
      "metis": {
        "model": "venice/qwen-3-8-27b",
        "reasoning": "xhigh",
        "temperature": 0.7,
        "top_p": 0.9,
        "maxTokens": 16384
      },
      "momus": {
        "model": "venice/qwen-3-8-27b",
        "reasoning": "xhigh",
        "temperature": 0.6,
        "top_p": 0.9,
        "maxTokens": 16384
      },
      "hephaestus": {
        "model": "venice/qwen-3-6-plus",
        "reasoning": "high",
        "temperature": 0.4,
        "top_p": 0.8,
        "maxTokens": 32768
      },
      "oracle": {
        "model": "venice/qwen-3-6-plus",
        "reasoning": "high",
        "temperature": 0.7,
        "top_p": 0.8,
        "maxTokens": 32768
      },
      "atlas": {
        "model": "venice/qwen-3-6-plus",
        "reasoning": "high",
        "temperature": 0.7,
        "top_p": 0.8,
        "maxTokens": 16384
      },
      "sisyphus-junior": {
        "model": "venice/olafangensan-glm-4.7-flash-heretic",
        "reasoning": "low",
        "temperature": 0.3,
        "top_p": 0.9,
        "maxTokens": 16384
      },
      "explore": {
        "model": "venice/olafangensan-glm-4.7-flash-heretic",
        "reasoning": "off",
        "temperature": 0.2,
        "top_p": 0.9,
        "maxTokens": 8192,
        "thinking": { "type": "disabled" }
      },
      "librarian": {
        "model": "venice/olafangensan-glm-4.7-flash-heretic",
        "reasoning": "off",
        "temperature": 0.2,
        "top_p": 0.9,
        "maxTokens": 8192,
        "thinking": { "type": "disabled" }
      },
      "multimodal-looker": {
        "model": "venice/qwen-3-8-27b",
        "reasoning": "low",
        "temperature": 0.3,
        "top_p": 0.9,
        "maxTokens": 8192
      },
      "build": {
        "model": "venice/qwen-3-6-plus",
        "reasoning": "high",
        "temperature": 0.3,
        "top_p": 0.8,
        "maxTokens": 32768
      },
      "plan": {
        "model": "venice/qwen-3-6-plus",
        "reasoning": "high",
        "temperature": 0.4,
        "top_p": 0.8,
        "maxTokens": 16384
      },
      "frontend": {
        "model": "venice/qwen-3-6-plus",
        "reasoning": "high",
        "temperature": 0.9,
        "top_p": 0.95,
        "maxTokens": 16384
      },
      "reviewer": {
        "model": "venice/qwen-3-6-plus",
        "reasoning": "high",
        "temperature": 0.3,
        "top_p": 0.8,
        "maxTokens": 16384
      }
    },

    "categories": {
      "visual-engineering": {
        "model": "venice/qwen-3-6-plus",
        "reasoning": "high",
        "temperature": 0.9,
        "top_p": 0.95,
        "maxTokens": 16384
      },
      "artistry": {
        "model": "venice/venice-uncensored-role-play",
        "reasoning": "off",
        "temperature": 0.9,
        "top_p": 0.95,
        "maxTokens": 16384,
        "thinking": { "type": "disabled" }
      },
      "ultrabrain": {
        "model": "venice/qwen-3-6-plus",
        "reasoning": "high",
        "temperature": 0.7,
        "top_p": 0.8,
        "maxTokens": 32768
      },
      "deep": {
        "model": "venice/qwen-3-6-plus",
        "reasoning": "high",
        "temperature": 0.7,
        "top_p": 0.8,
        "maxTokens": 32768
      },
      "quick": {
        "model": "venice/olafangensan-glm-4.7-flash-heretic",
        "reasoning": "off",
        "temperature": 0.2,
        "top_p": 0.9,
        "maxTokens": 4096,
        "thinking": { "type": "disabled" }
      },
      "unspecified-low": {
        "model": "venice/olafangensan-glm-4.7-flash-heretic",
        "reasoning": "low",
        "temperature": 0.3,
        "top_p": 0.9,
        "maxTokens": 8192
      },
      "unspecified-high": {
        "model": "venice/qwen-3-6-plus",
        "reasoning": "high",
        "temperature": 0.7,
        "top_p": 0.8,
        "maxTokens": 32768
      },
      "writing": {
        "model": "venice/venice-uncensored-1-2",
        "reasoning": "off",
        "temperature": 0.8,
        "top_p": 0.95,
        "maxTokens": 8192,
        "thinking": { "type": "disabled" }
      }
    },

    "background_task": {
      "providerConcurrency": { "venice": 5 },
      "modelConcurrency": {
        "venice/qwen-3-6-plus": 8,
        "venice/qwen-3-8-27b": 6,
        "venice/olafangensan-glm-4.7-flash-heretic": 10
      }
    },

    // preemptive-compaction is disabled on purpose: Magic Context is the single
    // compactor and two compactors conflict. context-window-monitor is not a
    // valid hook id in OMO 5.0.0-beta.62, so listing it did nothing and it is
    // removed rather than left as dead config.
    "disabled_hooks": [
      "preemptive-compaction",
      "anthropic-context-window-limit-recovery"
    ],

    "team_mode": {
      "enabled": true,
      "max_parallel_members": 4,
      "tmux_visualization": true
    }
  },

  // Anonymous telemetry off for a portable, opsec-conscious distribution.
  "telemetry": false,

  "_migrations": [
    "2026-08-reasoning-unification",
    "2026-07-opencode-config-unification"
  ],
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json"
}
